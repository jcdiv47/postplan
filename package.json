{
  "name": "postplan",
  "version": "0.0.1",
  "description": "Single-user static HTML draft publishing. A locked-down, zero-infra draft server.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "bin": {
    "postplan": "./src/postplan.ts"
  },
  "scripts": {
    "start": "bun src/postplan.ts serve",
    "serve": "bun src/postplan.ts serve",
    "build": "tsc",
    "typecheck": "tsc",
    "test": "bun test ./test/"
  },
  "dependencies": {
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "src",
    "public"
  ]
}
