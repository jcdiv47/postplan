{
  "name": "postplan",
  "version": "0.0.1",
  "description": "Single-user static HTML draft publishing. A locked-down, zero-infra draft server.",
  "type": "module",
  "private": true,
  "bin": {
    "postplan": "./bin/postplan.mjs"
  },
  "scripts": {
    "start": "node dist/postplan.js serve",
    "serve": "node src/postplan.ts serve",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:dist": "npm run build && POSTPLAN_TEST_TARGET=dist/postplan.js node --test test/*.test.ts"
  },
  "dependencies": {
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "public"
  ]
}
