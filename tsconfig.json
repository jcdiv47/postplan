{
  // Type-check only: Bun runs src/ directly, locally and on Railway, so
  // nothing is ever emitted (ADR-0005). `bun run build` is this check, which
  // makes a type error fail the deploy.
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,

    // Imports are written with a `.ts` extension, which is what Bun resolves
    // when it runs the source.
    "allowImportingTsExtensions": true,

    // Bun transpiles and would accept enums, namespaces and parameter
    // properties, but keeping to erasable syntax leaves the source runnable
    // by plain type stripping too (Node, or any future runtime) — a cheap
    // exit door we would otherwise close without noticing.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "public"]
}
